{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "面向实时交互的主从多 Agent 任务调度系统",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node --env-file-if-exists=.env src/app.ts --check",
    "start": "node --env-file-if-exists=.env src/app.ts",
    "example:sdk": "node --env-file-if-exists=.env examples/sdk/01-minimal.ts",
    "example:abort": "node --env-file-if-exists=.env examples/sdk/02-abort-and-tools.ts",
    "example:workers": "node --env-file-if-exists=.env examples/sdk/03-two-workers.ts",
    "example:lifecycle": "node --env-file-if-exists=.env examples/sdk/04-session-lifecycle.ts",
    "example:master": "node --env-file-if-exists=.env examples/sdk/05-master-decision.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
