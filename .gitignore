# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 凭据与本地配置：绝不入库
.env
.env.*
!.env.example
auth.json
.pi/

# Pi SDK 运行时产物：models.json 旁的模型注册表缓存（FileModelsStore 自动写入）
config/models-store.json

# Pi 会话与运行时产物
sessions/
*.session.jsonl
logs/
*.log
.tmp/

# 持久化数据（M7）：任务历史、决策轨迹、语义记忆都在这里
# 这些文件包含用户对话与屏幕摘要，**绝不入库**
.data/
*.db
*.db-wal
*.db-shm

# 测试与工具
coverage/
.vitest/

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db
