# 复制为 .env 后填入真实值：.env 已在 .gitignore 中，绝不要提交。
#
# 模型凭据由 Pi SDK 直接从进程环境读取（见 Pi docs/providers.md），
# 本项目的配置层只检测「是否存在」，从不回显、不落盘、不写日志。
# 至少启用下面其中一个 provider。

# DeepSeek
# DEEPSEEK_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# ===== 非敏感运行配置 =====

# debug | info | warn | error（默认 info）
JARVIS_LOG_LEVEL=info

# 指定模型；两者都留空时按「第一个有凭据的可用模型」选择
# 例：JARVIS_MODEL_PROVIDER=deepseek
#     JARVIS_MODEL_ID=deepseek-chat
JARVIS_MODEL_PROVIDER=
JARVIS_MODEL_ID=

# 推理等级：off | minimal | low | medium | high | xhigh | max（留空用 SDK 默认）
JARVIS_THINKING_LEVEL=

# Pi Session 的工作目录（留空用当前进程工作目录）
JARVIS_WORKSPACE=

# Pi 配置目录覆盖（默认 ~/.pi/agent）
# PI_CODING_AGENT_DIR=
