# 复制为 .env 后填入真实值：.env 已在 .gitignore 中，绝不要提交。
#
# 凭据来源有两种，任选其一：
#   A. 自定义 OpenAI 兼容端点（推荐用于本项目的 cf.api.fan 端点）——
#      密钥经 config/models.json 的 "apiKey": "$JARVIS_MODEL_API_KEY" 插值使用。
#   B. Pi 内置 provider —— SDK 直接从下列环境变量读取凭据（见 Pi docs/providers.md）。
# 本项目配置层只检测「是否存在」，从不回显、不落盘、不写日志。

# ===== A. 自定义 OpenAI 兼容端点 =====
JARVIS_MODEL_API_KEY=
JARVIS_MODEL_PROVIDER=cf-fan
JARVIS_MODEL_ID=deepseek-flash
JARVIS_MODELS_PATH=config/models.json

# ===== B. 内置 provider（可选） =====
# DEEPSEEK_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ===== 非敏感运行配置 =====

# debug | info | warn | error（默认 info）
JARVIS_LOG_LEVEL=info

# 并发执行上限（>= 1 的整数，默认 4）。调度器准入队列以此为准。
JARVIS_MAX_CONCURRENT_TASKS=4

# 推理等级：off | minimal | low | medium | high | xhigh | max（留空用 SDK 默认）
JARVIS_THINKING_LEVEL=

# Pi Session 的工作目录（留空用当前进程工作目录）
JARVIS_WORKSPACE=

# Pi 配置目录覆盖（默认 ~/.pi/agent）
# PI_CODING_AGENT_DIR=
